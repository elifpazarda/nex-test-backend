generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  password       String
  tokenVersion   Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  projects       Project[]
  jiraConnection JiraConnection?

  @@map("users")
}

model JiraConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  cloudId      String
  siteUrl      String
  siteName     String
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("jira_connections")
}

model Project {
  id             String           @id @default(cuid())
  name           String
  description    String?
  userId         String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarios      TestScenario[]
  scenarioGroups ScenarioGroup[]

  @@map("projects")
}

model TestScenario {
  id              String         @id @default(cuid())
  title           String
  input           String         @db.Text
  rawOutput       String         @db.Text
  bddOutput       String         @db.Text
  category        String         @default("")
  priority        String         @default("")
  preconditions   String         @default("") @db.Text
  steps           String[]       @default([])
  expectedResult  String         @default("") @db.Text
  sourceType      String?
  sourceRef       String?
  projectId       String
  groupId         String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group           ScenarioGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("test_scenarios")
}

enum ScenarioGroupType {
  BUG
  FEATURE
  REGRESSION
  SMOKE
  INTEGRATION
  E2E
  PERFORMANCE
  OTHER
}

model ScenarioGroup {
  id        String             @id @default(cuid())
  name      String
  type      ScenarioGroupType
  projectId String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenarios TestScenario[]

  @@map("scenario_groups")
}
