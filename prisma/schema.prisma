generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  password       String
  tokenVersion   Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  projects       Project[]
  jiraConnection JiraConnection?
  generations    Generation[]
  scmWebhooks    ScmWebhookConnection[]

  @@map("users")
}

model JiraConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  cloudId      String
  siteUrl      String
  siteName     String
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("jira_connections")
}

model Project {
  id             String           @id @default(cuid())
  name           String
  description    String?
  userId         String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarios      TestScenario[]
  scenarioGroups ScenarioGroup[]
  generations    Generation[]
  scmWebhooks    ScmWebhookConnection[]

  @@map("projects")
}

model TestScenario {
  id              String         @id @default(cuid())
  title           String
  input           String         @db.Text
  rawOutput       String         @db.Text
  bddOutput       String         @db.Text
  category        String         @default("")
  priority        String         @default("")
  preconditions   String         @default("") @db.Text
  steps           String[]       @default([])
  expectedResult  String         @default("") @db.Text
  sourceType      String?
  sourceRef       String?
  projectId       String
  groupId         String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group           ScenarioGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("test_scenarios")
}

enum GenerationStatus {
  SUCCESS
  WARNING
  FAILED
}

// Her AI uretim calistirmasinin kaydi (Gecmis / tum uretimler ekranini besler).
// Senaryolardan bagimsizdir: uret endpointleri kaydetmese bile burada bir "run"
// olusur, sure/durum/uretilen sayisi tutulur.
model Generation {
  id            String           @id @default(cuid())
  title         String
  sourceType    String // text | jira | excel | pdf
  sourceRef     String?
  scenarioCount Int              @default(0) // AI'nin urettigi senaryo sayisi
  savedCount    Int              @default(0) // kullanicinin kaydettigi (korunan) senaryo sayisi
  durationMs    Int              @default(0)
  status        GenerationStatus @default(SUCCESS)
  errorMessage  String?          @db.Text
  userId        String
  projectId     String
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("generations")
}

// SCM (GitHub) webhook baglantisi. Clarity gibi: URL'deki UUID bu kaydi isaret
// eder ve her baglantinin kendi secret'i (CryptoUtil ile sifreli) vardir.
// Payload URL: /api/v1/scm-webhooks/github/{id}
model ScmWebhookConnection {
  id            String            @id @default(uuid())
  provider      String // github
  label         String?
  secret        String            @db.Text // HMAC dogrulama secret'i (sifreli)
  active        Boolean           @default(true)
  autoGenerate  Boolean           @default(false) // uygun event'lerde otomatik senaryo uret
  targetGroupId String? // uretilen senaryolarin yazilacagi grup (autoGenerate icin zorunlu)
  userId        String
  projectId     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  targetGroup   ScenarioGroup?    @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)
  events        ScmWebhookEvent[]

  @@index([userId])
  @@map("scm_webhook_connections")
}

// Bir baglanti uzerinden gelen, imzasi dogrulanmis webhook teslimati.
model ScmWebhookEvent {
  id           String               @id @default(cuid())
  connectionId String
  provider     String // github
  eventType    String // X-GitHub-Event: push, issues, pull_request ...
  action       String? // payload.action: opened, closed ...
  deliveryId   String?              @unique // X-GitHub-Delivery (idempotency)
  sourceRef    String? // repository.full_name gibi okunabilir referans
  payload      Json
  status       String               @default("RECEIVED") // RECEIVED | PROCESSED | SKIPPED | FAILED
  error        String?              @db.Text
  createdAt    DateTime             @default(now())
  connection   ScmWebhookConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@map("scm_webhook_events")
}

enum ScenarioGroupType {
  BUG
  FEATURE
  REGRESSION
  SMOKE
  INTEGRATION
  E2E
  PERFORMANCE
  OTHER
}

model ScenarioGroup {
  id        String             @id @default(cuid())
  name      String
  type      ScenarioGroupType
  projectId String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenarios TestScenario[]
  scmWebhooks ScmWebhookConnection[]

  @@map("scenario_groups")
}
