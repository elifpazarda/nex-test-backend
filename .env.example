PORT=3001
NODE_ENV=development

DATABASE_URL="postgresql://postgres:password@localhost:5432/qa_platform"

JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your-refresh-secret-change-this
JWT_REFRESH_EXPIRES_IN=7d

ANTHROPIC_API_KEY=sk-ant-...

# AI senaryo uretiminde kullanilacak model (varsayilan: sonnet)
# Demo/sunumda daha hizli yanit icin: AI_MODEL=haiku
AI_MODEL=sonnet

# Jira token sifreleme anahtari (64 char hex onerilir: openssl rand -hex 32)
JIRA_TOKEN_ENCRYPTION_KEY=change-this-to-a-64-char-hex-string

# Atlassian OAuth 2.0 (3LO)
# https://developer.atlassian.com/console adresinden app olusturun
ATLASSIAN_CLIENT_ID=your-atlassian-app-client-id
ATLASSIAN_CLIENT_SECRET=your-atlassian-app-client-secret
ATLASSIAN_CALLBACK_URL=http://localhost:3001/api/jira/callback

FRONTEND_URL=http://localhost:3000

# SCM webhook'larinin payload URL'inde kullanilacak public taban adres.
# Bos birakilirsa http://localhost:<PORT> kullanilir.
# Her baglantinin secret'i DB'de (CryptoUtil ile) sifreli tutulur; global secret yoktur.
PUBLIC_API_URL=http://localhost:3001
