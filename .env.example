PORT=3001
NODE_ENV=development

DATABASE_URL="postgresql://postgres:password@localhost:5432/qa_platform"

JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your-refresh-secret-change-this
JWT_REFRESH_EXPIRES_IN=7d

ANTHROPIC_API_KEY=sk-ant-...

# Jira API token sifreleme anahtari (64 char hex onerilir: openssl rand -hex 32)
JIRA_TOKEN_ENCRYPTION_KEY=change-this-to-a-64-char-hex-string

FRONTEND_URL=http://localhost:3000
